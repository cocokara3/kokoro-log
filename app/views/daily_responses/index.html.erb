<h1>これまでの記録</h1>

<% @daily_responses.each do |response| %>
  <div style="border-bottom: 1px solid #ccc; margin-bottom: 10px;">
    <p><strong>日付:</strong> <%= response.logged_on %></p>
    <p><strong>気分:</strong> <%= response.mood_score %></p>
    <p><strong>一言:</strong> <%= response.answer_text %></p>
  </div>
<% end %>

<%= link_to "今日を記録する", new_daily_response_path %> |
<%= link_to "マイページ", user_path(current_user) %>
